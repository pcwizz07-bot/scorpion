# Copy to .env and fill in real local-dev values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://scorpion:REDACTED_DEV_PASSWORD@127.0.0.1:5432/scorpion

# Shared secret devices present when calling POST /api/v1/devices/register.
PROVISIONING_TOKEN=changeme-provisioning-token

# Fernet key used to encrypt IMSI values at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRYPTO_KEY=changeme-generate-a-real-fernet-key

# Window (seconds) within which a repeat observation of the same IMSI from the
# same device is treated as a duplicate and skipped.
DEDUP_WINDOW_SECONDS=60
